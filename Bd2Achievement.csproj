<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>Bd2Achievement.App</StartupObject>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ExporterWorker/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(X64Worker)' != ''">
    <EmbeddedResource Include="$(X64Worker)" LogicalName="exporter-x64.exe" />
  </ItemGroup>
</Project>
